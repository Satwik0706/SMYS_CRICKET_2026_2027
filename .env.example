# SMYS Cricket Auction Platform - Environment Variables
# For deployment to Vercel, set these in Vercel Project Settings -> Environment Variables.

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Administrator Credentials (Optional - Defaults to 'admin' / 'admin123' if omitted)
# Set these in Vercel to change the universal admin password across all devices.
VITE_ADMIN_ID=admin
VITE_ADMIN_PASSWORD=admin123
